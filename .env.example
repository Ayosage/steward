# Discord bot token (Discord Developer Portal > Bot). Never commit real values.
DISCORD_TOKEN=change-me
# Application (client) id, used for slash-command registration.
DISCORD_APP_ID=change-me
# Optional: register commands to a single guild for instant iteration.
DISCORD_GUILD_ID=

# Meridian game-launcher (webdev/meridian/docs/DISCORD-LAUNCH.md)
MERIDIAN_API_URL=http://localhost:2567
MERIDIAN_LAUNCH_TOKEN=change-me

# Wordy Champions Worker (github.com/Ayosage/wordy-champions)
WORDY_API_URL=http://localhost:8788
WORDY_LAUNCH_TOKEN=change-me

# Postgres connection (drizzle). Run `npm run db:migrate` after changing schema.
DATABASE_URL=postgres://localhost:5432/steward
# Port for the inbound result-webhook HTTP server.
WEBHOOK_PORT=8787
# Public base URL games use to reach the webhook (callback.url = <this>/webhooks/results).
PUBLIC_BASE_URL=http://localhost:8787
